{
  "name": "job-hunter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rimraf node_modules"
  },
  "devDependencies": {
    "@job-hunter/db": "workspace:*",
    "@job-hunter/icp": "workspace:*",
    "@job-hunter/scrapers": "workspace:*",
    "@job-hunter/workers": "workspace:*",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
