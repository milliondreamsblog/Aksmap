{
  "name": "@job-hunter/scrapers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./yc": {
      "types": "./dist/yc/index.d.ts",
      "import": "./dist/yc/index.js"
    },
    "./rss": {
      "types": "./dist/rss/index.d.ts",
      "import": "./dist/rss/index.js"
    },
    "./careers": {
      "types": "./dist/careers/index.d.ts",
      "import": "./dist/careers/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "smoke": "tsx src/scripts/smoke-test.ts"
  },
  "dependencies": {
    "@job-hunter/icp": "workspace:*",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.0",
    "p-retry": "^6.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
